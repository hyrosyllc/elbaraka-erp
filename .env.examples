# Copy these settings into .env.local for local development.
# Never commit the completed .env.local file. The browser preview remains
# available until a Supabase project is configured.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar
NEXT_PUBLIC_COUNTRY=MA
NEXT_PUBLIC_CURRENCY=MAD

# Supabase project settings. Public keys are safe in the browser only when
# every exposed table has correct RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Server-only key required by the manager invitation API. Never prefix it with
# NEXT_PUBLIC_. Prefer the new secret key; the legacy service-role name is
# supported only as a migration fallback.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=legacy-server-only-service-role-key

# Optional: Supabase Dashboard > Project > Connect > Session pooler.
# Replace every bracketed value. Percent-encode reserved characters in the password.
# The direct database endpoint may be unreachable on IPv4-only networks.
SUPABASE_DB_URL=
# Example:
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require

# Optional Mapbox public token for the client store map. Use only a restricted
# public token (pk.*); the authenticated API rejects secret-scope tokens.
# Restrict it to the required map styles/tiles and your app URLs.
# Store coordinates are entered manually; client addresses are not geocoded.
