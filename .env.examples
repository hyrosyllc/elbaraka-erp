# Copy these settings into .env.local for local development.
# Never commit the completed .env.local file. The browser preview remains
# available until a Supabase project is configured.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar
NEXT_PUBLIC_COUNTRY=MA
NEXT_PUBLIC_CURRENCY=MAD

# Supabase project settings. The anon/publishable key is public by design and
# is safe in the browser only when every exposed table has correct RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Compatibility with projects that still use the legacy anon key name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key required by the manager invitation API. Never prefix it with
# NEXT_PUBLIC_. Prefer the new secret key; the legacy service-role name is
# supported only as a migration fallback.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=legacy-server-only-service-role-key
